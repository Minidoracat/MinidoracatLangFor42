*.zip filter=lfs diff=lfs merge=lfs -text

# PZ JSON 翻譯引擎只接受 LF，CRLF 會導致翻譯檔被靜默忽略
*.json text eol=lf
*.lua text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.md text eol=lf
*.sh text eol=lf
mod.info text eol=lf

# workshop.txt 例外：遊戲內 Workshop 工具上傳時會把整檔回寫成 CRLF。
# 跟著遊戲的格式走，上傳後就不會每次都跳出「已修改」的假差異（入庫仍正規化為 LF）。
MOD/*/workshop.txt text eol=crlf
