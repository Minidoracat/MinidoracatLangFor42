    "Stash_IrvingtonMap3_Text4": "尸群",
    "Stash_IrvingtonMap4_Text1": "战争多么古怪离奇",
    "Stash_IrvingtonMap4_Text2": "你所击倒的那家伙",
    "Stash_IrvingtonMap4_Text3": "若在酒馆相遇, 本会请他喝一杯",
    "Stash_IrvingtonMap4_Text4": "或借他半克朗银币",
    "Stash_IrvingtonMap5_Text1": "这里应该有食物",
    "Stash_IrvingtonMap5_Text2": "除非特蕾莎把它们全拿走了",
    "Stash_IrvingtonMap6_Text1": "东西可能在这里",
    "Stash_IrvingtonMap6_Text2": "但要小心",
    "Stash_IrvingtonMap8_Text1": "餐馆",
    "Stash_IrvingtonMap8_Text2": "洗衣店",
    "Stash_IrvingtonMap8_Text3": "我不会是唯一剩下的人",
    "Stash_IrvingtonMap9_Text1": "我们可以在这里加强防御",
    "Stash_IrvingtonMap9_Text2": "一切都会好起来的!",
    "Stash_IrvingtonMap10_Text1": "欧文顿",
    "Stash_IrvingtonMap10_Text2": "我们会在这里",
    "Stash_WorldMap1_Text1": "卡拉会帮忙的",
    "Stash_WorldMap1_Text2": "慢点开车",
    "Stash_WorldMap2_Text1": "很好的基地",
    "Stash_WorldMap2_Text11": "到了先加固防御!",
    "Stash_WorldMap2_Text12": "给你藏了一些枪",
    "Stash_WorldMap3_Text1": "这里有丙烷罐",
    "Stash_WorldMap3_Text11": "你需要它",
    "Stash_WorldMap4_Text1": "亚娜说",
    "Stash_WorldMap4_Text11": "这是那个女人住的地方",
    "Stash_WorldMap4_Text12": "也许她会帮助我们",
    "Stash_WorldMap5_Text1": "保利把东西放在这里了",
    "Stash_WorldMap5_Text11": "别让放哨的人发现你",
    "Stash_WorldMap5_Text12": "别忘了烧掉这张地图!!!",
    "Stash_WorldMap6_Text1": "这里有好东西",
    "Stash_WorldMap6_Text2": "只搜刮物资 —— 太大, 无法设防",
    "Stash_WorldMap6_Text3": "安迪",
    "Stash_WorldMap7_Text1": "在这里",
    "Stash_WorldMap7_Text2": "全被感染了",
    "Stash_WorldMap7_Text21": "它们都是从哪里来的",
    "Stash_WorldMap9_Text1": "货运站",
    "Stash_WorldMap9_Text2": "到处都是箱子, 可以装满东西",
    "Stash_WorldMap9_Text3": "办公室, 什么都没有",
    "Stash_WorldMap9_Text4": "仓库",
    "Stash_WorldMap9_Text5": "马尔德劳",
    "Stash_WorldMap9_Text6": "这里的火车全都没法开? ? ?",
    "Stash_WorldMap10_Text1": "加油站",
    "Stash_WorldMap10_Text2": "服装店",
    "Stash_WorldMap10_Text3": "斯皮福餐厅",
    "Stash_WorldMap10_Text4": "汽车",
    "Stash_WorldMap11_Text1": "2 号塔上的 3 号天线 - 丢失信号",
    "Stash_WorldMap11_Text11": "在 6 GHz 频段上丢失信号 - 电源问题",
    "Stash_WorldMap11_Text2": "让总部和列克星敦一起测试",
    "Stash_WorldMap12_Text1": "大型露营地",
    "Stash_WorldMap12_Text11": "我们需要一切 (简需要的药丸除外)",
    "Stash_WorldMap12_Text2": "我们很快就能坐在火堆旁",
    "Stash_WorldMap12_Text21": "放声高歌",
    "Stash_WorldMap13_Text1": "哈尔, 我知道这很难",
    "Stash_WorldMap13_Text11": "但你真的该走了",
    "Stash_WorldMap13_Text12": "宝拉, 我们在这里",
    "Stash_WorldMap14_Text1": "奶奶",
    "Stash_WorldMap14_Text2": "爸爸在这里",
    "Stash_WorldMap16_Text1": "营地",
    "Stash_WorldMap16_Text2": "检查点",
    "Stash_WorldMap16_Text3": "障碍",
    "Stash_WorldMap17_Text1": "巡逻盲点",
    "Stash_WorldMap17_Text2": "V 将在 23:15 关闭传感器",
    "Stash_WorldMap17_Text21": "别分心! 拍完照就离开",
    "Stash_WorldMap19_Text1": "顽固的杂种!",
    "Stash_WorldMap19_Text11": "如果你死了, 我永远不会原谅你!!!",
    "Stash_WorldMap19_Text12": "你可能会活过这周",
    "Stash_WorldMap20_Text1": "白痴",
    "Stash_WorldMap20_Text2": "混蛋",
    "Stash_WorldMap20_Text3": "蠢货",
    "Stash_WorldMap22_Text1": "很好的基地!",
    "Stash_WorldMap23_Text1": "地下室",
    "Stash_WorldMap23_Text2": "雷霆加油站"
}
